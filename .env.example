# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAAA-your-token-here

# Папка со встроенными пакетами (.siq или распакованные папки с content.xml)
# PACKAGES_DIR=packages
# Папка для загруженных в чаты пакетов
# DATA_DIR=data

# MAX_PLAYERS=12
# Лимит размера загружаемого .siq. Облачный Bot API отдаёт ботам файлы до 20 МБ.
# MAX_UPLOAD_MB=20

# Свой сервер Bot API (https://github.com/tdlib/telegram-bot-api) снимает лимит 20 МБ:
# BOT_API_URL=http://localhost:8081
# BOT_API_LOCAL=true
